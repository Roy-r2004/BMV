# ── Local development env layout ──────────────────────────────
#
# API / Docker app config (edit this):
#   cp backend/.env.example backend/.env
#
# Frontend (Vite public vars only):
#   cp frontend/.env.example frontend/.env
#
# Production / VPS (separate from local — this root .env file):
#   cp .env.prod.example .env
#   ./scripts/deploy/hostinger-up.sh
#
# Local Docker does not need a root .env — compose loads backend/.env via env_file.

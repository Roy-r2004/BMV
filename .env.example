# =============================================================================
# Root .env — OPTIONAL, local Docker Compose only.
#
# Local app config does NOT live here. Full map: docs/ENVIRONMENT.md
#   backend/.env   — API + app config (keys, models, AppSpec, preview flags)
#   frontend/.env  — Vite public vars (VITE_* only)
#
# Only the four keys below are read from this file, and every one already has a
# working default in docker-compose.yml — so you can skip creating .env entirely.
# Create it only to override Postgres credentials or enable demo seeding:
#   cp .env.example .env
#
# Production does NOT use this file — see .env.prod.example.
# =============================================================================

# ── Local Postgres (docker-compose.yml `db` service) ─────────────────────────
POSTGRES_DB=buildmyversion
POSTGRES_USER=bmv
POSTGRES_PASSWORD=bmv-local-password

# ── Seed demo data on API boot (keep false to preserve real builds) ──────────
SEED_DEMO=false

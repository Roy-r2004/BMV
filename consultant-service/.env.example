# Everything routes through OpenRouter — one key, one place cost is tracked.
OPENROUTER_API_KEY=

# Text stages: analyze -> consult -> plan
ANALYSIS_MODEL=google/gemini-2.5-flash

# Image stage: an image-output-capable model available via OpenRouter's
# chat completions endpoint (modalities=["image","text"]). Confirmed working
# shape (pending credits): openai/gpt-5-image, openai/gpt-5-image-mini,
# openai/gpt-5.4-image-2, google/gemini-2.5-flash-image.
IMAGE_MODEL=google/gemini-3-pro-image

# Per-ROLE overrides. Empty = use the measured per-archetype table in
# config.py (ARCHETYPE_IMAGE_MODELS), and IMAGE_MODEL where that has no
# entry. Set these only to force one model for every archetype — bake-off
# runs and incident response. Tiering (pro anchor + flash follow-ups) is
# configured in the table, not here.
IMAGE_MODEL_ANCHOR=
IMAGE_MODEL_FOLLOWUP=

# Per-ROLE output canvas, sent as OpenRouter's image_config. Empty = ask for
# nothing and take the model's default (~1376x768). Follow-ups default to 2K:
# they run on gemini-3.1-flash-image, which honours the request (2752x1536,
# probe-measured $0.1019 vs $0.070) and which produced every collapsed
# letterform ("Cilents") in the session-33 sweep. The anchor default is empty
# because gemini-3-pro-image ignores the field on both slugs — measured
# 2026-08-12, docs/evidence/session34/probe/.
IMAGE_SIZE_ANCHOR=
IMAGE_SIZE_FOLLOWUP=2K
# Only sent alongside a size. 16:9 maps to the 1.79:1 shape the models
# already produce unprompted — pixel count changes, composition does not.
IMAGE_ASPECT_RATIO=16:9

# Role count is decided per-business by the plan stage, NOT fixed — these
# are just a floor (fallback only) and a cost/sanity ceiling.
MIN_ROLES_PER_REQUEST=2
MAX_ROLES_PER_REQUEST=4
VARIANTS_PER_ROLE=3

# Service
DATABASE_URL=sqlite:///./consultant.db
PORT=8002
FRONTEND_ORIGIN=http://localhost:5173

# ── Demo-screenshot pipeline (cost knobs — this is lead gen) ─────────────
# Screens per request: anchor dashboard + follow-ups (2-3).
DEMO_SCREEN_COUNT=3
# Candidates for the anchor screen (vision judge picks the best one).
# 2, not 3: the anchor runs on the pro-class model, so this is the knob
# that moves a request's cost most. 3 projects to ~$0.60 -- exactly on the
# DoD ceiling; 2 projects to ~$0.45. See tests/test_cost_model.py.
DASHBOARD_CANDIDATES=2
SECONDARY_CANDIDATES=1
# Vision-model QA over every candidate (cheap flash call per image).
ENABLE_VISION_QA=true
QA_MODEL=google/gemini-2.5-flash
QA_MIN_SCORE=8
# Head-to-head "which of these two is better" judging (evaluation scripts
# only, never the request path). Needs a comparator that survives the
# order-swap test: gemini-2.5-flash answered "A" in 6 of 6 runs regardless
# of content. Empty = fall back to QA_MODEL.
PAIRWISE_JUDGE_MODEL=anthropic/claude-sonnet-5
# Transcribe the rendered text and diff brand-critical strings (business
# name, product name, nav labels) against the spec. A misspelled client
# name auto-rejects the screen whatever its aesthetic score.
ENABLE_TEXT_TRUTH_GATE=true
# Per-screen structural defect check: one inspector reports countable
# structural defects (text claims forbidden), each claim goes to a separate
# verifier told to refute it; a claim both stages agree on rejects the
# candidate. Runs concurrently with the judge and transcription. ~$0.002
# per candidate on the flash model.
ENABLE_DEFECT_CHECK=true
DEFECT_MODEL=google/gemini-2.5-flash
# At most one extra attempt per screen when nothing is approved.
MAX_REGENERATIONS=1
# Attach the anchor screenshot to follow-up calls for a consistent look
# (needs an image-input-capable image model, e.g. google/gemini-3-pro-image).
USE_REFERENCE_IMAGES=true

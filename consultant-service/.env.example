# Everything routes through OpenRouter — one key, one place cost is tracked.
OPENROUTER_API_KEY=

# Text stages: analyze -> consult -> plan
ANALYSIS_MODEL=google/gemini-2.5-flash

# Image stage: an image-output-capable model available via OpenRouter's
# chat completions endpoint (modalities=["image","text"]). Confirmed working
# shape (pending credits): openai/gpt-5-image, openai/gpt-5-image-mini,
# openai/gpt-5.4-image-2, google/gemini-2.5-flash-image.
IMAGE_MODEL=google/gemini-3-pro-image

# Per-ROLE overrides. Empty = use the measured per-archetype table in
# config.py (ARCHETYPE_IMAGE_MODELS), and IMAGE_MODEL where that has no
# entry. Set these only to force one model for every archetype — bake-off
# runs and incident response. Tiering (pro anchor + flash follow-ups) is
# configured in the table, not here.
IMAGE_MODEL_ANCHOR=
IMAGE_MODEL_FOLLOWUP=

# Role count is decided per-business by the plan stage, NOT fixed — these
# are just a floor (fallback only) and a cost/sanity ceiling.
MIN_ROLES_PER_REQUEST=2
MAX_ROLES_PER_REQUEST=4
VARIANTS_PER_ROLE=3

# Service
DATABASE_URL=sqlite:///./consultant.db
PORT=8002
FRONTEND_ORIGIN=http://localhost:5173

# ── Demo-screenshot pipeline (cost knobs — this is lead gen) ─────────────
# Screens per request: anchor dashboard + follow-ups (2-3).
DEMO_SCREEN_COUNT=3
# Candidates for the anchor screen (vision judge picks the best one).
DASHBOARD_CANDIDATES=3
SECONDARY_CANDIDATES=1
# Vision-model QA over every candidate (cheap flash call per image).
ENABLE_VISION_QA=true
QA_MODEL=google/gemini-2.5-flash
QA_MIN_SCORE=7
# At most one extra attempt per screen when nothing is approved.
MAX_REGENERATIONS=1
# Attach the anchor screenshot to follow-up calls for a consistent look
# (needs an image-input-capable image model, e.g. google/gemini-3-pro-image).
USE_REFERENCE_IMAGES=true

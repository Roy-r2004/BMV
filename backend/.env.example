DATABASE_URL=sqlite:///./buildmyversion.db

ADMIN_PASSWORD=change_this_password
# Auto-created admin user on boot (no manual SQL)
ADMIN_EMAIL=roy.rizkallah@hotmail.com
ADMIN_NAME=Roy
ADMIN_USER_PASSWORD=change_this_password
ADMIN_SYNC_PASSWORD=true

ROY_WHATSAPP_NUMBER=replace_with_number

UPLOAD_DIR=./app/uploads
# PREVIEW_TEMPLATE_DIR=./preview-template
# PREVIEW_APPS_DIR=./app/uploads/preview-apps
# STATIC_DIR=/app/static
# INTERNAL_BASE_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── AI provider ────────────────────────────────────────────────
# openrouter = cloud API (recommended for local dev — no GPU/model pulls)
# ollama     = self-hosted local models
AI_PROVIDER=openrouter

# OpenRouter (when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=Build My Version

# Pexels (per-business preview imagery — never commit real keys)
PEXELS_API_KEY=

# ── Models (optional — defaults are set per provider in app/core/config.py) ──
# Public site guide chatbot (cheapest — OpenRouter free router by default)
# SITE_CHAT_ENABLED=true
# SITE_CHAT_MODEL=openrouter/free

# Blueprints / proposals / chat refinements
TEXT_MODEL=google/gemini-2.5-flash
# VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct
# CODER_MODEL=qwen/qwen-2.5-coder-32b-instruct
# HTML_MODEL=openai/gpt-4o
# React preview app codegen
PREVIEW_APP_MODEL=deepseek/deepseek-chat
# Design critic + build fix loop
ARCHITECT_MODEL=google/gemini-2.5-flash
CRITIC_MODEL=google/gemini-2.5-flash
# Vite build-fix + quality-gate dynamic repair (strong coder recommended)
FIX_MODEL=z-ai/glm-5.2
QUALITY_FIX_MODEL=z-ai/glm-5.2

# Quality bar (defaults ON — set true only for faster local iteration)
PREVIEW_GENERATOR_V2=false
PREVIEW_SKIP_CRITIC=false
PREVIEW_SKIP_VISUAL_CRITIC=false
# Catalogue pages: scaffold-first (default ON). Slot-fill customizes copy once.
PREVIEW_SCAFFOLD_FIRST=true
PREVIEW_SCAFFOLD_SLOT_FILL=true
PREVIEW_PARALLEL_WORKERS=4
PREVIEW_MAX_FILES=40
PREVIEW_MAX_BUILD_FIX_ATTEMPTS=6
PREVIEW_MAX_FIX_LOOP_SECONDS=900
PREVIEW_MAX_AI_CALLS=96
# Sandboxed AI repair after deterministic quality heals (ops/script/rewrite)
PREVIEW_QUALITY_AI_REPAIR=true
PREVIEW_MAX_QUALITY_FIX_ATTEMPTS=2

# ── Logging ───────────────────────────────────────────────────
# trace | debug | info | warning | error
LOG_LEVEL=debug

# Local Docker compose: auto-reload API on Python file changes.
UVICORN_RELOAD=true
WATCHFILES_FORCE_POLLING=true

# ── Canonical AppSpec ─────────────────────────────────────────
# off: legacy behavior; on: author, enforce, and drive the UI for every preview.
APPSPEC_MODE=off
APPSPEC_SCHEMA_VERSION=1.0
APPSPEC_PROMPT_REVISION=2026-07-15.1
APPSPEC_MODEL=google/gemini-2.5-flash
APPSPEC_REPAIR_MODEL=google/gemini-2.5-flash
# Use a separately configurable reviewer so the author does not self-grade.
APPSPEC_COVERAGE_MODEL=google/gemini-2.5-flash
# v2 only: unknown or author-matching families fail before provider calls.
APPSPEC_V2_COVERAGE_MODEL=anthropic/claude-haiku-4.5
APPSPEC_MAX_CALLS=6
APPSPEC_MAX_REPAIR_ATTEMPTS=3
APPSPEC_MAX_TOKENS=24000
APPSPEC_REPAIR_MAX_TOKENS=24000
APPSPEC_COVERAGE_MAX_TOKENS=6000
APPSPEC_MIN_COVERAGE_SCORE=95
APPSPEC_PREVIEW_TARGET_PAGES=6
APPSPEC_PREVIEW_MAX_PAGES=8

# Preview generator v2 Phase 2 design-contract stages.
V2_PRODUCT_STRATEGY_MODEL=deepseek/deepseek-v4-pro
V2_INFORMATION_ARCHITECTURE_MODEL=google/gemini-2.5-flash
V2_DESIGN_DNA_MODEL=z-ai/glm-5.2
V2_DESIGN_DNA_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct
V2_PRODUCT_STRATEGY_PROMPT_REVISION=2026-07-24.1
V2_INFORMATION_ARCHITECTURE_PROMPT_REVISION=2026-07-24.1
V2_DESIGN_DNA_PROMPT_REVISION=2026-07-24.1
V2_PRODUCT_STRATEGY_MAX_TOKENS=4500
V2_INFORMATION_ARCHITECTURE_MAX_TOKENS=9000
V2_DESIGN_DNA_MAX_TOKENS=5000
V2_DESIGN_STAGE_MAX_ATTEMPTS=2
V2_PRODUCT_STRATEGY_TIMEOUT_SECONDS=90
V2_INFORMATION_ARCHITECTURE_TIMEOUT_SECONDS=120
V2_DESIGN_DNA_TIMEOUT_SECONDS=120
V2_DESIGN_CONTRACT_TIMEOUT_SECONDS=300
V2_DESIGN_CONTRACT_MAX_COST_USD=0.25

# Preview generator v2 Phase 3A composition-contract stages.
V2_BUSINESS_COMPONENT_MODEL=deepseek/deepseek-v4-pro
V2_CONTENT_DATA_MODEL=qwen/qwen-2.5-coder-32b-instruct
V2_BUSINESS_COMPONENT_PROMPT_REVISION=2026-07-24.1
V2_CONTENT_DATA_PROMPT_REVISION=2026-07-24.1
V2_BUSINESS_COMPONENT_MAX_TOKENS=8000
V2_CONTENT_DATA_MAX_TOKENS=10000
V2_COMPOSITION_AI_STAGE_MAX_ATTEMPTS=2
V2_BUSINESS_COMPONENT_TIMEOUT_SECONDS=120
V2_CONTENT_DATA_TIMEOUT_SECONDS=120
V2_COMPOSITION_CONTRACT_TIMEOUT_SECONDS=240
V2_COMPOSITION_CONTRACT_MAX_CALLS=4
V2_COMPOSITION_CONTRACT_MAX_COST_USD=0.20

# Phase 3B immutable Tier 1 candidate generation (2 cold AI calls)
V2_CANDIDATE_POLICY_REVISION=2026-07-24.1
V2_CANDIDATE_COMPONENT_MODEL=deepseek/deepseek-v4-pro
V2_CANDIDATE_PAGE_MODEL=deepseek/deepseek-v4-pro
V2_CANDIDATE_REPAIR_MODEL=z-ai/glm-5.2
V2_CANDIDATE_COMPONENT_PROMPT_REVISION=2026-07-24.1
V2_CANDIDATE_PAGE_PROMPT_REVISION=2026-07-24.1
V2_CANDIDATE_REPAIR_PROMPT_REVISION=2026-07-24.1
V2_CANDIDATE_COMPONENT_MAX_TOKENS=24000
V2_CANDIDATE_PAGE_MAX_TOKENS=32000
V2_CANDIDATE_REPAIR_MAX_TOKENS=10000
V2_CANDIDATE_COMPONENT_TIMEOUT_SECONDS=240
V2_CANDIDATE_PAGE_TIMEOUT_SECONDS=300
V2_CANDIDATE_REPAIR_TIMEOUT_SECONDS=150
V2_CANDIDATE_TIMEOUT_SECONDS=600
V2_CANDIDATE_MAX_CALLS=4
V2_CANDIDATE_MAX_COST_USD=0.25

# Phase 4 isolated build and deterministic runtime validation (zero AI calls)
V2_RUNTIME_VALIDATION_ENABLED=false
V2_RUNTIME_POLICY_REVISION=2026-07-24.1
V2_RUNTIME_TYPESCRIPT_TIMEOUT_SECONDS=90
V2_RUNTIME_VITE_BUILD_TIMEOUT_SECONDS=120
V2_RUNTIME_BUILD_TIMEOUT_SECONDS=180
V2_RUNTIME_SERVER_TIMEOUT_SECONDS=20
V2_RUNTIME_ROUTE_TIMEOUT_SECONDS=15
V2_RUNTIME_JOURNEY_TIMEOUT_SECONDS=30
V2_RUNTIME_ACCESSIBILITY_TIMEOUT_SECONDS=15
V2_RUNTIME_SCREENSHOT_TIMEOUT_SECONDS=10
V2_RUNTIME_PHASE_TIMEOUT_SECONDS=600
V2_RUNTIME_MAX_BROWSER_CONTEXTS=2
V2_RUNTIME_MAX_BROWSER_PAGES=2
V2_RUNTIME_MAX_CONSOLE_DIAGNOSTICS=100
V2_RUNTIME_MAX_NETWORK_DIAGNOSTICS=100
V2_RUNTIME_MAX_COMMAND_OUTPUT_BYTES=65536
V2_RUNTIME_MAX_DETERMINISTIC_REPAIRS=1
V2_RUNTIME_MAX_DIST_BYTES=5242880
V2_RUNTIME_MAX_JAVASCRIPT_BYTES=2097152
V2_RUNTIME_MAX_CSS_BYTES=524288
V2_RUNTIME_MAX_DIST_FILES=200
V2_RUNTIME_MAX_SOURCE_MAPS=0

# Phase 6A cumulative Tier 2 orchestration (disabled; no Tier 3)
V2_TIER2_GENERATION_ENABLED=false
V2_TIER2_GENERATION_POLICY_REVISION=2026-07-24.1
V2_TIER2_COMPONENT_MODEL=deepseek/deepseek-v4-pro
V2_TIER2_PAGE_MODEL=deepseek/deepseek-v4-pro
V2_TIER2_REPAIR_MODEL=z-ai/glm-5.2
V2_TIER2_COMPONENT_PROMPT_REVISION=2026-07-24.1
V2_TIER2_PAGE_PROMPT_REVISION=2026-07-24.1
V2_TIER2_MAX_CALLS=10
V2_TIER2_MAX_OUTPUT_TOKENS=118000
V2_TIER2_MAX_COST_USD=1.75
V2_TIER2_MAX_WALL_SECONDS=2400

# Phase 6B cumulative Tier 3 orchestration (disabled by default)
V2_TIER3_GENERATION_ENABLED=false
V2_TIER3_GENERATION_POLICY_REVISION=2026-07-24.1
V2_TIER3_COMPONENT_MODEL=deepseek/deepseek-v4-pro
V2_TIER3_PAGE_MODEL=deepseek/deepseek-v4-pro
V2_TIER3_REPAIR_MODEL=z-ai/glm-5.2
V2_TIER3_COMPONENT_PROMPT_REVISION=2026-07-24.1
V2_TIER3_PAGE_PROMPT_REVISION=2026-07-24.1
V2_TIER3_MAX_CALLS=12
V2_TIER3_MAX_OUTPUT_TOKENS=168000
V2_TIER3_MAX_COST_USD=2.50
V2_TIER3_MAX_WALL_SECONDS=3600

# Phase 7A rollout control plane (fail closed; never serves candidates)
V2_PHASE7_ROLLOUT_ENABLED=false
V2_PHASE7_SHADOW_ENABLED=false
V2_PHASE7_PROMOTE_ENABLED=false
V2_PHASE7_ROLLOUT_PERCENT=0
V2_PHASE7_REQUEST_ALLOWLIST=
V2_PHASE7_CIRCUIT_BREAKER_ENABLED=false
V2_PHASE7_AUTO_ROLLBACK_ENABLED=false
V2_PHASE7_AUTO_ROLLBACK_LOOKBACK_SECONDS=3600
V2_PHASE7_BREAKER_EVAL_MAX_REQUESTS=50
V2_PHASE7_OPS_DASHBOARD_ENABLED=false
V2_PHASE7_OPS_ALERTS_ENABLED=false
V2_PHASE7_OPS_ALERT_LOOKBACK_SECONDS=3600
V2_PHASE7_POLICY_REVISION=2026-07-25.1
V2_PHASE7_ROLLOUT_SALT=2026-07-25.1
V2_PHASE7_ALLOW_ADMIN_DUAL_ROLE=false
V2_PHASE7_SHADOW_MODE=reuse_accepted
V2_PHASE7_SHADOW_COMPARE_ENABLED=true
V2_PHASE7_SHADOW_LIVE_PROVIDERS_ENABLED=false
V2_PHASE7_SHADOW_MAX_CONCURRENCY=1
V2_PHASE7_SHADOW_MAX_WALL_SECONDS=3600
# Phase 7F percent serve + live canary (defaults fail closed; keep percent at 0)
V2_PHASE7_PERCENT_SERVE_ENABLED=false
V2_PHASE7_PERCENT_REQUIRES_CANARY=true
V2_PHASE7_LIVE_CANARY_ENABLED=false
V2_PHASE7_LIVE_CANARY_PROVIDERS_ENABLED=false
# Local/test fixture simulation only — structurally disabled in production APP_ENV
V2_PHASE7_CANARY_SIMULATION_ENABLED=false
V2_PHASE7_CANARY_MAX_CALLS=12
V2_PHASE7_CANARY_MAX_INPUT_TOKENS=50000
V2_PHASE7_CANARY_MAX_OUTPUT_TOKENS=20000
V2_PHASE7_CANARY_MAX_COST_USD=5.0
V2_PHASE7_CANARY_MAX_WALL_SECONDS=1200
V2_PHASE7_CANARY_MAX_RETRIES=1
V2_PHASE7_CANARY_PER_CALL_TIMEOUT_SECONDS=120
V2_PHASE7_CANARY_APPROVAL_TTL_SECONDS=3600

# Ollama (when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

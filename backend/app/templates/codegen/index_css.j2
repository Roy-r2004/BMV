{{ font_import | default('') }}
@import "tailwindcss";

@theme {
  --color-background: color-mix(in srgb, {{ primary }} {{ bg_mix }}, white);
  --color-foreground: color-mix(in srgb, {{ primary }} {{ fg_mix }}, black);
  --color-muted: color-mix(in srgb, {{ primary }} {{ muted_mix }}, #64748b);
  --color-card: {{ card_color }};
  --color-border-subtle: color-mix(in srgb, {{ primary }} {{ border_mix }}, #e2e8f0);
  --color-brand: {{ primary }};
  --color-brand-dark: {{ secondary }};
  --color-accent: {{ secondary }};
  --color-ring: {{ primary }};
  --color-chart: {{ secondary }};
  --font-sans: {{ font_sans }};
  --font-display: {{ font_display }};
  --radius-ui: {{ radius_ui }};
  --shadow-ui: {{ shadow_ui }} color-mix(in srgb, {{ primary }} {{ shadow_alpha }}, transparent);
  --glow-atmosphere: color-mix(in srgb, {{ primary }} {{ glow }}, transparent);
  --treatment-light: {{ primary }};
  --recipe-atmosphere: {{ atmosphere }};
}

@layer base {
  :root {
    color: var(--color-foreground);
    background:
      var(--recipe-atmosphere),
      var(--color-background);
    background-attachment: fixed;
  }
  body {
    margin: 0;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  html { scroll-behavior: smooth; }
  :focus-visible { outline: 2px solid var(--color-ring); outline-offset: 2px; }
  h1, h2, h3, .font-display {
    font-family: var(--font-display);
  }
}

.ui-treatment-light {
  background: linear-gradient(180deg, transparent 0%, var(--treatment-light) 22%, var(--treatment-light) 78%, transparent 100%);
}

/* Cinematic utilities — kept in sync with preview-template/src/index.css */
@keyframes ui-kenburns {
  from { transform: scale(1.04); }
  to { transform: scale(1.14); }
}

@keyframes ui-marquee {
  from { transform: translateX(0); }
  /* Exactly one copy of the duplicated track — keeps the seam invisible. */
  to { transform: translateX(-50%); }
}

@keyframes ui-fade-up {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

.ui-kenburns { animation: ui-kenburns 32s ease-out both; }
.ui-marquee-track { animation: ui-marquee 56s linear infinite; }

.ui-film-grain {
  pointer-events: none;
  position: absolute;
  inset: 0;
  opacity: 0.18;
  mix-blend-mode: soft-light;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
}

.ui-vignette {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, transparent 35%, rgb(0 0 0 / 0.55) 100%);
}

.ui-hero-sheen {
  pointer-events: none;
  position: absolute;
  inset: -20% -10%;
  background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.12) 48%, transparent 62%);
  animation: ui-fade-up 1.4s ease-out both;
}

@media (prefers-reduced-motion: reduce) {
  .ui-marquee-track,
  .ui-kenburns,
  .ui-hero-sheen {
    animation: none;
  }
}

/* AI-invented color class aliases — keep generated pages readable. */
.text-text-color,
.text-text_color,
.text-muted-text {
  color: var(--color-foreground);
}
.text-muted-text-color,
.text-muted_text_color {
  color: var(--color-muted);
}
.text-danger {
  color: #dc2626;
}

[data-recipe="editorial"] .font-display,
[data-recipe="warm-service"] .font-display {
  font-style: italic;
  letter-spacing: -0.03em;
}

[data-recipe="dense-ops"] .font-display,
[data-recipe="bold-retail"] .font-display {
  font-style: normal !important;
  letter-spacing: -0.02em;
}

[data-recipe="dense-ops"] .font-display {
  font-family: var(--font-sans) !important;
  font-weight: 600;
}

[data-recipe="dense-ops"] section {
  padding-block: clamp(2rem, 3.5vw, 3.25rem) !important;
}

[data-recipe="bold-retail"] .font-display {
  text-transform: uppercase;
  letter-spacing: -0.04em;
}

[data-recipe="warm-service"] section:not([data-hero]) {
  padding-block: clamp(3.5rem, 7vw, 6.5rem);
}

      "statement": "Service availability (dates and times) is pre-configured and managed externally, and the calendar component will consume this data."
    },
    {
      "confidence": "high",
      "id": "ASSUMPTION-NO-PAYMENT-INTEGRATION",
      "rationale": "Customer explicitly stated: 'Do not include an admin dashboard, marketplace, payment or checkout flow, or standalone AI Features page.'",
      "statement": "There is no payment or checkout flow required as explicitly stated by the customer."
    },
    {
      "confidence": "high",
      "id": "ASSUMPTION-NO-ADMIN-DASHBOARD",
      "rationale": "Customer explicitly stated: 'Do not include an admin dashboard, marketplace, payment or checkout flow, or standalone AI Features page.'",

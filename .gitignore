# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
**/*.pyc
**/__pycache__/
backend/*.db
backend/app/uploads/*
!backend/app/uploads/.gitkeep

# Node
frontend/node_modules/
frontend/dist/
backend/preview-template/node_modules/
backend/preview-template/dist/

# Local debug dumps (scripts/read_html.py)
backend/page_*.html

# Env — deny all real env files at any depth; allow only *.example templates.
# Covers .env, .env.prod, .env.staging, .env.local, backend/.env, frontend/.env …
.env
.env.*
!.env.example
!.env.*.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Separate project — never commit into BMV
bmv-core/

# Local one-off debug / repair scripts (never commit)
/_*.py
/_*/
/backend/app/_[^_]*.py
!/backend/app/__init__.py

# Editor / agent local state
.agents/
.cursor/

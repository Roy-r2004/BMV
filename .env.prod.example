# Production / Hostinger VPS — copy to .env before:
#   docker compose -f docker-compose.prod.yml up -d --build

# Your public domain (A-record → VPS IP). Also create traefik.YOURDOMAIN for the proxy UI.
DOMAIN=yourdomain.com

# Let's Encrypt certificate email
ACME_EMAIL=you@example.com

# Traefik dashboard basic auth (optional — default user admin / password "password")
# Generate: htpasswd -nb admin yourpassword
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

ADMIN_PASSWORD=change_this_strong_password
ROY_WHATSAPP_NUMBER=replace_with_number

# ── AI (recommended on Hostinger: OpenRouter — no GPU, ~2GB app RAM) ──
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# Optional imagery
# PEXELS_API_KEY=

TEXT_MODEL=google/gemini-2.5-flash
PREVIEW_APP_MODEL=deepseek/deepseek-chat
CRITIC_MODEL=google/gemini-2.5-flash
FIX_MODEL=google/gemini-2.5-flash

# AppSpec (shadow = author contracts but still ship UI if rejected)
APPSPEC_MODE=shadow
APPSPEC_MAX_CALLS=6
APPSPEC_MAX_REPAIR_ATTEMPTS=3
APPSPEC_MIN_COVERAGE_SCORE=95
APPSPEC_PREVIEW_TARGET_PAGES=6
APPSPEC_PREVIEW_MAX_PAGES=8

PREVIEW_SKIP_CRITIC=false
PREVIEW_SKIP_VISUAL_CRITIC=false
PREVIEW_PARALLEL_WORKERS=2

# ── Optional: self-hosted Ollama instead (needs 8GB+ RAM VPS) ──
# AI_PROVIDER=ollama
# TEXT_MODEL=llama3.1:8b
# VISION_MODEL=llama3.2-vision
# CODER_MODEL=qwen2.5-coder:7b
# PULL_MODELS=true
# Then:
#   docker compose -f docker-compose.prod.yml --profile ollama --profile init run --rm ollama-init
#   docker compose -f docker-compose.prod.yml --profile ollama up -d --build

# =============================================================================
# Hostinger VPS production env (OpenRouter — no local Ollama)
# Copy on the server:  cp .env.prod.example .env
# Then fill every CHANGE_ME value. Never commit a real .env.
# =============================================================================

# ── Domain / TLS (Traefik + Let's Encrypt) ───────────────────────────────────
DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=you@CHANGE_ME.example.com
# Optional Traefik dashboard basic-auth (htpasswd). Leave empty to use compose default.
# Generate: docker run --rm httpd:2 alpine htpasswd -nbB admin 'your-password'
TRAEFIK_DASHBOARD_AUTH=

# ── App secrets ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME_strong_password
# Bootstraps /admin login user automatically (no SQL)
ADMIN_EMAIL=roy.rizkallah@hotmail.com
ADMIN_NAME=Roy
ADMIN_USER_PASSWORD=CHANGE_ME_admin_login_password
ADMIN_SYNC_PASSWORD=true
ROY_WHATSAPP_NUMBER=9613840728

# ── AI: OpenRouter only (recommended on Hostinger) ───────────────────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=CHANGE_ME_sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Build My Version
# Shown to OpenRouter as HTTP-Referer (use your live https domain)
OPENROUTER_SITE_URL=https://CHANGE_ME.example.com

# Optional stock photos for previews
PEXELS_API_KEY=

# Models (OpenRouter slugs)
TEXT_MODEL=google/gemini-2.5-flash
PREVIEW_APP_MODEL=deepseek/deepseek-chat
ARCHITECT_MODEL=google/gemini-2.5-flash
CRITIC_MODEL=google/gemini-2.5-flash
FIX_MODEL=google/gemini-2.5-flash
QUALITY_FIX_MODEL=z-ai/glm-5.2
VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# Quality bar — keep critics ON in production
PREVIEW_SKIP_CRITIC=false
PREVIEW_SKIP_VISUAL_CRITIC=false
PREVIEW_PARALLEL_WORKERS=2
PREVIEW_QUALITY_AI_REPAIR=true
PREVIEW_MAX_QUALITY_FIX_ATTEMPTS=2
PREVIEW_MAX_BUILD_FIX_ATTEMPTS=5
PREVIEW_MAX_FIX_LOOP_SECONDS=600
LOG_LEVEL=info
PULL_MODELS=false
# Do not auto-insert the PlateSync seed demo on boot
SEED_DEMO=false

# AppSpec ON for production one-shot quality
APPSPEC_MODE=on
APPSPEC_SCHEMA_VERSION=1.0
APPSPEC_PROMPT_REVISION=2026-07-15.1
APPSPEC_MODEL=google/gemini-2.5-flash
APPSPEC_REPAIR_MODEL=google/gemini-2.5-flash
APPSPEC_COVERAGE_MODEL=google/gemini-2.5-flash
APPSPEC_MAX_CALLS=6
APPSPEC_MAX_REPAIR_ATTEMPTS=3
APPSPEC_MAX_TOKENS=24000
APPSPEC_REPAIR_MAX_TOKENS=24000
APPSPEC_COVERAGE_MAX_TOKENS=6000
APPSPEC_MIN_COVERAGE_SCORE=95
APPSPEC_PREVIEW_TARGET_PAGES=6
APPSPEC_PREVIEW_MAX_PAGES=8

# CORS is set from DOMAIN in docker-compose.prod.yml (https://${DOMAIN})
# Do not set AI_PROVIDER=ollama on Hostinger unless you have a large GPU VPS.

# =============================================================================
# Production env TEMPLATE — placeholders only. Never put real values here.
#
# Your filled copy belongs in ONE of these (both are gitignored):
#   .env       — Hostinger VPS path, created on the server
#   .env.prod  — local working copy / paste source for the Coolify UI
#
# Path A — Hostinger VPS (docker-compose.prod.yml + Traefik):
#   cp .env.prod.example .env && nano .env
#   bash scripts/deploy/hostinger-up.sh
#
# Path B — Coolify (docker-compose.coolify.yml or Dockerfile.app):
#   paste these keys into the Coolify environment editor
#
# NOTE: both compose files forward an explicit allowlist of vars into the
# container — a key present here but absent from that list has NO effect.
# Blocks marked [not-forwarded] are affected. See docs/ENVIRONMENT.md.
# =============================================================================

# ── Deploy identity / TLS (Traefik + Let's Encrypt) ──────────────────────────
APP_ENV=production
DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=you@CHANGE_ME.example.com
# Optional Traefik dashboard basic-auth (htpasswd). Empty = compose default.
# Generate: docker run --rm httpd:2-alpine htpasswd -nbB admin 'your-password'
TRAEFIK_DASHBOARD_AUTH=
# Path A derives CORS from DOMAIN. Coolify needs it set explicitly.
CORS_ORIGINS=https://CHANGE_ME.example.com

# ── Admin / secrets ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME_strong_password
# Bootstraps the /admin login user on boot (no SQL)
ADMIN_EMAIL=you@CHANGE_ME.example.com
ADMIN_NAME=CHANGE_ME
ADMIN_USER_PASSWORD=CHANGE_ME_admin_login_password
ADMIN_SYNC_PASSWORD=true
# Optional Discord/Slack webhook for admin alerts
ADMIN_ALERT_WEBHOOK_URL=
ROY_WHATSAPP_NUMBER=CHANGE_ME_number

# ── AI provider: OpenRouter only (no GPU needed) ─────────────────────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=CHANGE_ME_sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Build My Version
# Sent to OpenRouter as HTTP-Referer — use your live https domain
OPENROUTER_SITE_URL=https://CHANGE_ME.example.com
# Optional stock photography for preview imagery
PEXELS_API_KEY=
# Never enable local model pulls in production
PULL_MODELS=false

# ── Models (OpenRouter slugs) ────────────────────────────────────────────────
TEXT_MODEL=google/gemini-3-flash-preview
ARCHITECT_MODEL=anthropic/claude-haiku-4.5
CRITIC_MODEL=anthropic/claude-haiku-4.5
# :nitro = throughput routing; default routing pinned glm-5.2 to a ~60 t/s
# provider, past the 120s per-call cap at real fix sizes (session 18).
FIX_MODEL=z-ai/glm-5.2:nitro
# Preview codegen. Must be large-context: deepseek-chat is 32k and fails
# preflight on large prompts. A slow model degrades output silently rather than
# erroring — truncated slot fills keep the scaffold. See docs/ENVIRONMENT.md.
PREVIEW_APP_MODEL=deepseek/deepseek-v4-pro
CODER_MODEL=deepseek/deepseek-chat
QUALITY_FIX_MODEL=z-ai/glm-5.2
VISION_MODEL=google/gemini-2.5-flash

# ── Preview pipeline quality (keep critics ON in production) ─────────────────
PREVIEW_SKIP_CRITIC=false
PREVIEW_SKIP_VISUAL_CRITIC=false
PREVIEW_PARALLEL_WORKERS=2
PREVIEW_QUALITY_AI_REPAIR=true
PREVIEW_MAX_QUALITY_FIX_ATTEMPTS=2
# [not-forwarded]
PREVIEW_MAX_BUILD_FIX_ATTEMPTS=5
PREVIEW_MAX_FIX_LOOP_SECONDS=600

# ── Logging / data ───────────────────────────────────────────────────────────
# [not-forwarded] — container falls back to config.py default "debug"
LOG_LEVEL=info
# Never auto-insert PlateSync — keeps real builds across redeploys.
# Coolify: also add Persistent Storage mounted at /app/data (SQLite + previews).
SEED_DEMO=false

# ── AppSpec (ON for production one-shot quality) ─────────────────────────────
APPSPEC_MODE=on
APPSPEC_SCHEMA_VERSION=1.0
APPSPEC_PROMPT_REVISION=2026-07-28.2
APPSPEC_MODEL=google/gemini-2.5-flash
APPSPEC_REPAIR_MODEL=google/gemini-2.5-flash
# Reviewer must be a different family from the author so it does not self-grade.
APPSPEC_COVERAGE_MODEL=deepseek/deepseek-chat
APPSPEC_V2_COVERAGE_MODEL=deepseek/deepseek-chat
APPSPEC_MAX_CALLS=6
APPSPEC_MAX_REPAIR_ATTEMPTS=3
# Schema-only repair attempts (separate budget; 1 is guaranteed even when
# APPSPEC_MAX_REPAIR_ATTEMPTS is 0). Raise to 2-3 when the author emits
# empty required tuples / duplicate IDs. Bounded by APPSPEC_MAX_CALLS.
APPSPEC_MAX_SCHEMA_REPAIR_ATTEMPTS=3
APPSPEC_MAX_DETERMINISTIC_HEALS=4
APPSPEC_FALLBACK_ENABLED=false
APPSPEC_MAX_TOKENS=24000
APPSPEC_REPAIR_MAX_TOKENS=24000
APPSPEC_COVERAGE_MAX_TOKENS=6000
APPSPEC_MIN_COVERAGE_SCORE=95
APPSPEC_PREVIEW_TARGET_PAGES=6
APPSPEC_PREVIEW_MAX_PAGES=8

# ── Phase 7 rollout control plane ────────────────────────────────────────────
# Phase 7B shadow lane: ROLLOUT_ENABLED is the master gate that shadow needs,
# but it CANNOT serve on its own — both percent_serve.py and promotion_service.py
# additionally require V2_PHASE7_PROMOTE_ENABLED. With PROMOTE false,
# percent_serve returns mode="legacy" and promotion raises "flags_off", so
# customers keep the served v1 preview. Keep PROMOTE + PERCENT_SERVE false and
# ROLLOUT_PERCENT at 0 until V2 reaches quality parity with v1.
V2_PHASE7_ROLLOUT_ENABLED=true
V2_PHASE7_OPS_DASHBOARD_ENABLED=true
V2_PHASE7_OPS_ALERTS_ENABLED=true
V2_PHASE7_SHADOW_ENABLED=true
# reuse_accepted | regenerate_fixture. regenerate_live is blocked in code.
V2_PHASE7_SHADOW_MODE=reuse_accepted
V2_PHASE7_SHADOW_COMPARE_ENABLED=true
V2_PHASE7_SHADOW_LIVE_PROVIDERS_ENABLED=false
V2_PHASE7_SHADOW_MAX_CONCURRENCY=1
V2_PHASE7_SHADOW_MAX_WALL_SECONDS=3600
# ── Serving gates — these are what actually change what a customer sees ──────
V2_PHASE7_PROMOTE_ENABLED=false
V2_PHASE7_ROLLOUT_PERCENT=0
V2_PHASE7_ROLLOUT_SALT=2026-07-25.1
V2_PHASE7_PERCENT_SERVE_ENABLED=false
V2_PHASE7_LIVE_CANARY_ENABLED=false
V2_PHASE7_LIVE_CANARY_PROVIDERS_ENABLED=false
V2_PHASE7_AUTO_ROLLBACK_ENABLED=false
V2_PHASE7_SHADOW_LIVE_PROVIDERS_ENABLED=false
# Fixture simulation only — structurally disabled when APP_ENV=production
V2_PHASE7_CANARY_SIMULATION_ENABLED=false
V2_PHASE7_CIRCUIT_BREAKER_ENABLED=false
V2_PHASE7_ALLOW_ADMIN_DUAL_ROLE=false

# ── Release metadata (Coolify only — keep commented out on the VPS path) ─────
# Set this ONLY in the Coolify UI, where Coolify substitutes $SOURCE_COMMIT at
# build time. In a .env file, Compose interpolates it itself and it resolves to
# an empty string plus a warning — so leave it commented for Path A.
#APP_GIT_REVISION=$SOURCE_COMMIT
# Supplied by the deployment system. Never hardcode a timestamp here.
APP_BUILD_TIMESTAMP=

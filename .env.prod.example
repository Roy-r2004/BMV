# Production — copy to .env before: docker compose -f docker-compose.prod.yml up -d

# Your public domain (must point to this server's IP)
DOMAIN=buildmyversion.example.com

# Let's Encrypt certificate email
ACME_EMAIL=you@example.com

# Traefik dashboard basic auth (optional — default user admin / password "password")
# Generate: htpasswd -nb admin yourpassword
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...

ADMIN_PASSWORD=change_this_password
ROY_WHATSAPP_NUMBER=replace_with_number

# Run once on first deploy (good connection):
# docker compose -f docker-compose.prod.yml --profile init run --rm ollama-init
PULL_MODELS=true

TEXT_MODEL=llama3.1:8b
VISION_MODEL=llama3.2-vision
CODER_MODEL=qwen2.5-coder:7b

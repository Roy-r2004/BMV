# consultant-service: standalone image-demo pipeline (FastAPI + Pillow +
# python-pptx). No Node/Playwright needed — unlike the main backend, this
# service never runs a browser or a preview-app build.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_URL=sqlite:////app/data/consultant.db \
    PORT=8002

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/consultant-service

COPY consultant-service/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY consultant-service/ ./

# BMV_LOGO_PATH (app/config.py) resolves three directories up from
# app/config.py to <repo-root>/frontend/public/logo.png — preserve that
# relative layout inside the image.
COPY frontend/public/logo.png /app/frontend/public/logo.png

# UPLOADS_DIR (app/config.py) is a hardcoded "<consultant-service>/uploads"
# path, not env-configurable — redirect it to the persistent volume with a
# symlink rather than changing app code just for deployment plumbing.
RUN rm -rf uploads \
    && mkdir -p /app/data/uploads/images /app/data/uploads/exports \
    && ln -s /app/data/uploads uploads

VOLUME ["/app/data"]

EXPOSE 8002

HEALTHCHECK --interval=20s --timeout=10s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]

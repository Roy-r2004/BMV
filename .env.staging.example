# Staging environment example — copy to .env.staging (never commit real secrets).
# Usage:
#   cp .env.staging.example .env.staging
#   # edit ADMIN_* and optional staging-only OPENROUTER_API_KEY
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build

APP_ENV=staging
DOMAIN=staging.example.com

# Separate staging database (Postgres in compose). Never point at production.
POSTGRES_DB=buildmyversion_staging
POSTGRES_USER=bmv_staging
POSTGRES_PASSWORD=replace_with_staging_db_password
DATABASE_URL=postgresql://bmv_staging:replace_with_staging_db_password@db:5432/buildmyversion_staging

# Unique staging admins (not production credentials)
ADMIN_PASSWORD=replace_with_unique_staging_admin_password
ADMIN_EMAIL=staging-admin@example.com
ADMIN_NAME=Staging Admin
ADMIN_USER_PASSWORD=replace_with_unique_staging_user_password
ADMIN_SYNC_PASSWORD=true

# Staging-only provider key (optional). Leave empty to avoid live spend.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
PEXELS_API_KEY=

# Frontend
VITE_API_BASE_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com,http://localhost:5173
INTERNAL_BASE_URL=http://127.0.0.1:8000

# Preview Generator v2 — Tier 1 path + admin-controlled Tier 2 capability
PREVIEW_GENERATOR_V2=true
V2_RUNTIME_VALIDATION_ENABLED=true
V2_VISUAL_EVALUATION_ENABLED=false
V2_TIER2_GENERATION_ENABLED=true
V2_TIER3_GENERATION_ENABLED=false

# Phase 7 hard gates for initial staging (do not raise percent)
V2_PHASE7_ROLLOUT_ENABLED=true
V2_PHASE7_OPS_DASHBOARD_ENABLED=true
V2_PHASE7_OPS_ALERTS_ENABLED=true
V2_PHASE7_SHADOW_ENABLED=false
V2_PHASE7_PROMOTE_ENABLED=false
V2_PHASE7_ROLLOUT_PERCENT=0
V2_PHASE7_PERCENT_SERVE_ENABLED=false
V2_PHASE7_LIVE_CANARY_ENABLED=false
V2_PHASE7_LIVE_CANARY_PROVIDERS_ENABLED=false
V2_PHASE7_AUTO_ROLLBACK_ENABLED=false
V2_PHASE7_SHADOW_LIVE_PROVIDERS_ENABLED=false
V2_PHASE7_CANARY_SIMULATION_ENABLED=false
V2_PHASE7_CIRCUIT_BREAKER_ENABLED=false
V2_PHASE7_ALLOW_ADMIN_DUAL_ROLE=false

SEED_DEMO=false
LOG_LEVEL=info
